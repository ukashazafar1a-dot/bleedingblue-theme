<section class="provider-section">
  <div class="page-width">
    <h2 class="provider-title">{{ section.settings.section_heading }}</h2>

    {% for block in section.blocks %}
      <details class="provider-card" role="group" aria-label="{{ block.settings.provider_name }}">
        <summary class="provider-summary">
          <div class="summary-content">
            {% if block.settings.provider_image != blank %}
              <img 
  src="{{ block.settings.provider_image | img_url: 'compact' }}" 
  alt="{{ block.settings.provider_name }}"
  class="provider-thumb"
  width="80"
  height="80"
/>

            {% else %}
              <div class="provider-thumb provider-thumb--placeholder" aria-hidden="true"></div>
            {% endif %}

            <div class="summary-text">
              <h3 class="provider-name">{{ block.settings.provider_name }}</h3>
              {% if block.settings.provider_title != blank %}
                <p class="provider-title-credentials">{{ block.settings.provider_title }}</p>
              {% endif %}
              {% if block.settings.provider_location != blank %}
                <p class="provider-location">{{ block.settings.provider_location }}</p>
              {% endif %}
            </div>
          </div>
        </summary>

        <div class="provider-details">
          {% if block.settings.provider_practice != blank %}
            <p><strong>Practice:</strong> {{ block.settings.provider_practice }}</p>
          {% endif %}
          {% if block.settings.provider_link != blank %}
            <p><strong>Website:</strong> <a href="{{ block.settings.provider_link }}" target="_blank" rel="noopener">Visit Website</a></p>
          {% endif %}

          {% if block.settings.provider_description != blank %}
            <div class="provider-desc">{{ block.settings.provider_description }}</div>
          {% endif %}

          {% if block.settings.specialties != blank %}
            <p><strong>Specialties & Expertise:</strong><br />{{ block.settings.specialties }}</p>
          {% endif %}

          {% if block.settings.fees != blank %}
            <p><strong>Fees:</strong> {{ block.settings.fees }}</p>
          {% endif %}

          {% if block.settings.insurance != blank %}
            <p><strong>Insurance Accepted:</strong><br />{{ block.settings.insurance }}</p>
          {% endif %}

          {% if block.settings.contact != blank %}
            <p><strong>Contact:</strong> {{ block.settings.contact }}</p>
          {% endif %}
        </div>
      </details>
    {% endfor %}
  </div>
</section>

<style>
.provider-section { padding: 32px 0; }
.provider-title { text-align:center; margin-bottom:20px; font-size:28px; }
.provider-card { border:1px solid #e6e6e6; border-radius:8px; margin-bottom:12px; background:#fff; overflow:hidden; }
.provider-summary { cursor:pointer; display:block; padding:14px; background:#fafafa; }
.provider-summary:hover { background:#f0f0f0; }
.summary-content { display:flex; gap:14px; align-items:center; }
.provider-thumb { width:64px; height:64px; border-radius:50%; object-fit:cover; }
.provider-thumb--placeholder { width:64px; height:64px; border-radius:50%; background:#eee; }
.summary-text .provider-name { margin:0; font-size:18px; }
.provider-details { padding:14px; border-top:1px solid #eee; background:#fff; }
.provider-details p { margin:8px 0; }
</style>
