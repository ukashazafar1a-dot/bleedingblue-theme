    "custom_liquid_hntfDJ": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n    .sponsors-carousel-container {\n        width: 100%;\n        max-width: 960px;\n        margin: 0 auto;\n        overflow: hidden;\n        position: relative;\n    }\n    \n    .sponsors-carousel {\n        display: flex;\n        gap: 50px;\n        /* No transition property here - we'll animate with JS for perfect smoothness */\n    }\n    \n    .sponsors-carousel-item {\n        max-width: 150px;\n        height: 135px;\n        flex: 0 0 auto;\n        position: relative;\n        overflow: hidden;\n        border-radius: 8px;\n        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n    }\n    \n    .sponsors-carousel-item img {\n        width: 100%;\n        height: 100%;\n        object-fit: contain;\n       \n    }\n    \n    .sponsors-heading {\n        text-align: center;\n        margin-bottom: 20px;\n    }\n</style>\n\n<h2 class=\"sponsors-heading\">Sponsors</h2>\n\n<div class=\"sponsors-carousel-container\">\n    <div class=\"sponsors-carousel\" id=\"sponsorsCarousel\">\n        <!-- Original images -->\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/commisioner.png?v=1745368412\" alt=\"commisioner\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/09apparellogo-05.png?v=1745367672\" alt=\"Image 2\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/ORCF-logo_BW_jpg_1.jpg?v=1745367340\" alt=\"Image 4\">\n        </div>\n         <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/DCFCU_Horizontal_Logo.png?v=1745367530\" alt=\"Image 3\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/MENTAL_HEALTH_EVENT_PROGRAM_10.png?v=1745367269\" alt=\"Image 5\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/LOGO_POAT_FINAL-no-motto-ai.webp?v=1745367231\" alt=\"Image 6\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/dimelo305.webp?v=1745367195\" alt=\"Image 7\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/CPRFLogo.png?v=1745367129\" alt=\"Image 8\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/chill.png?v=1745367070\" alt=\"Image 9\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/Screenshot_2025-04-23_at_8.13.24_PM.png?v=1745460847\" alt=\"Image 10\">\n        </div>\n         <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/BBC.jpg?v=1745635481\" alt=\"Image 3\">\n        </div>\n        <!-- Duplicate set for seamless scrolling -->\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/commisioner.png?v=1745368412\" alt=\"commisioner\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/09apparellogo-05.png?v=1745367672\" alt=\"Image 2\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/ORCF-logo_BW_jpg_1.jpg?v=1745367340\" alt=\"Image 4\">\n        </div>\n         <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/DCFCU_Horizontal_Logo.png?v=1745367530\" alt=\"Image 3\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/MENTAL_HEALTH_EVENT_PROGRAM_10.png?v=1745367269\" alt=\"Image 5\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/LOGO_POAT_FINAL-no-motto-ai.webp?v=1745367231\" alt=\"Image 6\">\n         <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/dimelo305.webp?v=1745367195\" alt=\"Image 7\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/CPRFLogo.png?v=1745367129\" alt=\"Image 8\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/chill.png?v=1745367070\" alt=\"Image 9\">\n        </div>\n        <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/Screenshot_2025-04-23_at_8.13.24_PM.png?v=1745460847\" alt=\"Image 10\">\n        </div>\n         <div class=\"sponsors-carousel-item\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0678/7235/8678/files/BBC.jpg?v=1745635481\" alt=\"Image 3\">\n        </div>\n        \n    </div>\n</div>\n\n<script>\n    (function() {\n        // Wait for DOM and images to be ready\n        function ready(fn) {\n            if (document.readyState === 'complete') {\n                fn();\n            } else {\n                window.addEventListener('load', fn);\n            }\n        }\n        \n        ready(function() {\n            // Get elements\n            const carousel = document.getElementById('sponsorsCarousel');\n            if (!carousel) return; // Safety check\n            \n            // Calculate some values\n            const items = carousel.querySelectorAll('.sponsors-carousel-item');\n            const totalOriginalItems = items.length / 2; // Half of the items (original set)\n            \n            // Calculate the width of a single item including gap\n            const firstItem = items[2];\n            const itemStyle = window.getComputedStyle(firstItem);\n            const itemWidth = firstItem.offsetWidth + parseInt(itemStyle.marginRight || 0) + 50; // 20px is our gap\n            \n            // Calculate the width of the original set\n            const setWidth = itemWidth * totalOriginalItems;\n            \n            // Variables for animation\n            let position = 0;\n            let speed = 1; // pixels per frame - adjust for speed\n            let isPlaying = true;\n            let animationId = null;\n            \n            // Functions\n            function animate() {\n                if (!isPlaying) {\n                    animationId = requestAnimationFrame(animate);\n                    return;\n                }\n                \n                // Move the carousel\n                position += speed;\n                \n                // Reset position exactly when needed for perfect looping\n                if (position >= setWidth) {\n                    position = 0;\n                }\n                \n                // Apply the transform\n                carousel.style.transform = `translateX(-${position}px)`;\n                \n                // Continue animation\n                animationId = requestAnimationFrame(animate);\n            }\n            \n            // Event listeners\n            carousel.addEventListener('mouseenter', function() {\n                isPlaying = false;\n            });\n            \n            carousel.addEventListener('mouseleave', function() {\n                isPlaying = true;\n            });\n            \n            // Handle tab visibility\n            document.addEventListener('visibilitychange', function() {\n                isPlaying = !document.hidden;\n            });\n            \n            // Handle window resize\n            let resizeTimeout;\n            window.addEventListener('resize', function() {\n                clearTimeout(resizeTimeout);\n                resizeTimeout = setTimeout(function() {\n                    // Recalculate values if needed\n                    const newItemStyle = window.getComputedStyle(firstItem);\n                    const newItemWidth = firstItem.offsetWidth + parseInt(newItemStyle.marginRight || 0) + 20;\n                    \n                    // Adjust position proportionally if the item width changed\n                    if (newItemWidth !== itemWidth) {\n                        const ratio = newItemWidth / itemWidth;\n                        position = position * ratio;\n                    }\n                }, 250);\n            });\n            \n            // Make sure all images are loaded before starting\n            let loadedImages = 0;\n            const totalImages = items.length;\n            \n            function checkAllImagesLoaded() {\n                loadedImages++;\n                if (loadedImages === totalImages) {\n                    // All images loaded, start animation\n                    animationId = requestAnimationFrame(animate);\n                }\n            }\n            \n            // Check existing images\n            items.forEach(item => {\n                const img = item.querySelector('img');\n                if (img.complete) {\n                    checkAllImagesLoaded();\n                } else {\n                    img.addEventListener('load', checkAllImagesLoaded);\n                    img.addEventListener('error', checkAllImagesLoaded); // Handle error too\n                }\n            });\n            \n            // Backup - start animation after a short delay if images are taking too long\n            setTimeout(fun