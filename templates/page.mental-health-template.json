        "text_rdepjC": {
          "type": "text",
          "settings": {
            "text": "<p>A mental health movement encouraging first responders to seek the assistance they need! Here, you will have a preview to resources that are available to you during difficult moments. <strong>JUST ASK</strong> for help, <strong>JUST ASK</strong> for advice, <strong>JUST ASK</strong> for friendship, <strong>JUST ASK</strong> for support. </p>",
            "text_style": "body"
          }
