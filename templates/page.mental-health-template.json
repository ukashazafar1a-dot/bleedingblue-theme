    "collapsible_content_dj49K3": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_MAieDx": {
          "type": "collapsible_row",
          "settings": {
            "heading": "COVER NOW",
            "icon": "chat_bubble",
            "row_content": "<p>Cover Now provides confidential mental health therapy and financial support to law enforcement officers and their families who have suffered job related trauma.</p><p>(619) 908-1250</p><p><a href=\"mailto:info@covernowfund.org\" target=\"_blank\" title=\"mailto:info@covernowfund.org\">info@covernowfund.org</a></p>",
            "page": ""
          }
        },
        "collapsible_row_mPUfgU": {
          "type": "collapsible_row",
          "settings": {
            "heading": "SHATTERPROOF FHE Health First Responders’ Program",
            "icon": "chat_bubble",
            "row_content": "<p>Shatterproof FHE Health is a specialized addiction and mental health treatment program for first responders.</p><p>Call for Immediate Help<a href=\"tel:+18444233081\">(844) 423-3081</a></p><p><a href=\"https://fherehab.com/learning/what-sets-shatterproof-apart\" target=\"_blank\" title=\"https://fherehab.com/learning/what-sets-shatterproof-apart\"><em>https://fherehab.com/learning/what-sets-shatterproof-apart</em></a></p>",
            "page": ""
          }
        },
        "collapsible_row_fCBM3N": {
          "type": "collapsible_row",
          "settings": {
            "heading": "THE OVERWATCH COLLECTIVE",
            "icon": "chat_bubble",
            "row_content": "<p>501 (c) (3) Non-Profit & Podcast Funding Therapy and Supporting Mental Health for First Responders, Military, & Their Families.</p><p><a href=\"https://www.theoverwatchcollective.com/\" target=\"_blank\" title=\"https://www.theoverwatchcollective.com/\">https://www.theoverwatchcollective.com/</a></p>",
            "page": ""
          }
        },
        "collapsible_row_AFH6XY": {
          "type": "collapsible_row",
          "settings": {
            "heading": "FELLOWSHIP OF CHRISTIAN PEACE OFFICERS",
            "icon": "chat_bubble",
            "row_content": "<p>The Fellowship of Christian Peace Officers (FCPO) is a national ministry comprised of Christian men and women from all areas of the criminal justice system.</p><p>Miami-Dade, Florida Chapter</p><p>Direct: (305) 283-5915</p><p><a href=\"mailto:Jorge@miamidadefcpo.org\">Jorge@miamidadefcpo.org</a></p>",
            "page": ""
          }
        },
        "collapsible_row_QYaDcd": {
          "type": "collapsible_row",
          "settings": {
            "heading": "FISHING WITH AMERICA'S FINEST",
            "icon": "chat_bubble",
            "row_content": "<p>Fishing with America’s Finest is dedicated to providing veterans and their families with no-cost recreational therapy fishing trips.</p><p>Captain Neal Stark, Founder</p><p>Evan Graver, United States Navy</p><p><a href=\"http://www.fwaf.net/\">www.fwaf.net</a></p><p>954-822-1481</p>",
            "page": ""
          }
        },
        "collapsible_row_Hit3wt": {
          "type": "collapsible_row",
          "settings": {
            "heading": "WOUNDED WARRIOR PROJECT",
            "icon": "chat_bubble",
            "row_content": "<p>Wounded Warrior Project offers an innovative, personal approach to veteran mental health and wellness that centers around you.</p><p><a href=\"https://www.woundedwarriorproject.org/programs/mental-wellness\" target=\"_blank\" title=\"https://www.woundedwarriorproject.org/programs/mental-wellness\">https://www.woundedwarriorproject.org/programs/mental-wellness</a></p>",
            "page": ""
          }
        },
        "collapsible_row_ftHfpY": {
          "type": "collapsible_row",
          "settings": {
            "heading": "LE MENTAL HEALTH COLLAB SUPPORT CENTER",
            "icon": "chat_bubble",
            "row_content": "<p>The goal of the center is to connect law enforcement agencies and their partners with the resources, knowledge, and skills necessary to respond to people at the intersection of law enforcement and behavioral health.</p><p>https://csgjusticecenter.org/resources/le-mh-collaboration-support-center/</p><p>Support by phone (1-888-920-0782) or email <a href=\"mailto:LEsupport@csg.org\">LEsupport@csg.org</a></p>",
            "page": ""
          }
        }
      },
